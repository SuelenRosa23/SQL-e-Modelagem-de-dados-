-- Liste todos os veículos com o nome do cliente dono.
SELECT c.nome, v.placa, v.modelo AS modelo 
FROM veiculos v
JOIN Clientes c ON v.Id_Clientes = c.Id_Clientes;

-- Liste todos os serviços realizados, mostrando o veículo, o cliente e o mecânico responsável
SELECT 
    s.Id_Servicos AS ID_Servico,
    s.Descricao AS Servico,
    s.Data_Servico AS Data,
    s.Valor AS Valor,
    v.Modelo AS Veiculo,
    v.Placa AS Placa,
    c.Nome AS Cliente,
    m.Nome AS Mecanico,
    m.Especialidade AS Especialidade
FROM servicos s
JOIN veiculos v ON s.id_veiculo = v.Id_Veiculos
JOIN clientes c ON v.Id_Clientes = c.Id_Clientes
JOIN mecanicos m ON s.id_mecanico = m.Id_Mecanicos
ORDER BY s.Id_Servicos;

-- Liste os serviços realizados por um mecanico especifico (exemplo, Carlos)
SELECT 
    s.Id_Servicos AS ID_Servico,
    s.Descricao AS Servico,
    s.Data_Servico AS Data,
    s.Valor AS Valor,
    v.Modelo AS Veiculo,
    v.Placa AS Placa,
    c.Nome AS Cliente,
    m.Nome AS Mecanico
FROM servicos s
JOIN veiculos v ON s.id_veiculo = v.Id_Veiculos
JOIN clientes c ON v.Id_Clientes = c.Id_Clientes
JOIN mecanicos m ON s.id_mecanico = m.Id_Mecanicos
WHERE m.Nome = 'Carlos'
ORDER BY s.Data_Servico;

-- Mostre todos os veículos que já realizaram serviços acima de R$500.00
SELECT 
    v.Modelo,
    v.Placa,
    c.Nome AS Nome_Cliente,
    s.Descricao AS Servico,
    s.Valor,
    s.Data_Servico
FROM servicos s
JOIN veiculos v ON s.Id_Veiculo = v.Id_Veiculos
JOIN clientes c ON v.Id_Clientes = c.Id_Clientes
WHERE s.Valor > 500.00;

-- Crie uma VIEW chamada vw_servicos_realizados que mostre: 
# Nome do cliente 
# Modelo do veículo 
# Descrição do serviço 
# Mecânico responsável 
# Valor e data do serviço 

CREATE VIEW vw_servicos_realizados AS
SELECT
    c.Nome AS Nome_Cliente,
    v.Modelo AS Modelo_Veiculo,
    s.Descricao AS Descricao_Servico,
    m.Nome AS Mecanico_Responsavel,
    s.Valor,
    s.Data_Servico
FROM servicos s
JOIN veiculos v ON s.Id_Veiculo = v.Id_Veiculos
JOIN clientes c ON v.Id_Clientes = c.Id_Clientes
JOIN mecanicos m ON s.Id_Mecanico = m.Id_Mecanicos;

-- Faça uma consulta na view retornando apenas os serviços realizados por “Suelen” (cliente) ordenados pela data do serviço.
SELECT *
FROM vw_servicos_realizados
WHERE Nome_Cliente = 'Suelen Rosa'
ORDER BY Data_Servico;
