CREATE DATABASE exercicio02;
 USE exercicio02;
 CREATE TABLE clientes(
 Id_Clientes 	INT 			AUTO_INCREMENT PRIMARY KEY,
 Nome 			VARCHAR(100)	NOT NULL,
 Tel			VARCHAR(20));
 
 CREATE TABLE veiculos(
 Id_Veiculos	INT				AUTO_INCREMENT PRIMARY KEY,
 Modelo			VARCHAR(20)		NOT NULL,
 Placa			VARCHAR(10)		UNIQUE NOT NULL,
 id_clientes	INT				NOT NULL,
 FOREIGN KEY (Id_Clientes) REFERENCES Clientes(Id_Clientes));
 
 CREATE TABLE mecanicos(
 Id_Mecanicos	INT				AUTO_INCREMENT PRIMARY KEY,
 Nome			VARCHAR(100)	NOT NULL,
 Especialidade	VARCHAR(50)		NOT NULL);
 
CREATE TABLE servicos(
Id_Servicos		INT				AUTO_INCREMENT PRIMARY KEY,
Descricao		VARCHAR(100)    NOT NULL,
Data_Servico	DATE			NOT NULL,
Valor			DECIMAL(10,2)	NOT NULL,
id_veiculo 		INT 			NOT NULL,
id_mecanico 	INT				NOT NULL,
    FOREIGN KEY (id_veiculo) REFERENCES Veiculos(Id_Veiculos),
    FOREIGN KEY (id_mecanico) REFERENCES Mecanicos(Id_Mecanicos)
);


