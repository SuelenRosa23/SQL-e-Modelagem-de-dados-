CREATE TABLE funcionário(
Id				INT PRIMARY KEY 	AUTO_INCREMENT,
Nome			VARCHAR(100) 		NOT NULL,
Cpf 			VARCHAR(11)			NOT NULL,
Matricula		VARCHAR(10)			NOT NULL,
DataAdmissao	DATE);
